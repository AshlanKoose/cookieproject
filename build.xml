<!-- https://ant.apache.org/manual/using.html -->
<!-- https://www.vogella.com/tutorials/ApacheAnt/article.html -->
<project name="JUnit" default="run">
	<target name="run" depends="build">
        	<java jar="junit.jar" fork="true">
			<arg line="discover --class-path . --scan-class-path"/>
		</java>
		<java jar="junit.jar" fork="true">
			<arg line="execute --class-path . --scan-class-path"/>
		</java>

	</target>
	<target name="build">
		<javac srcdir="." includeantruntime="false" debug="true">  <!--set debug to false for production-->
			<classpath>
				<pathelement location="junit.jar"/>
			</classpath>
		</javac>
	</target>
    <target name="clean">
        <delete>
			<fileset dir="." includes="*.class"/>
        </delete>
        <delete dir="docs" />
    </target>
    <target name="javadoc">
		<mkdir dir="docs"/>
		<javadoc destdir="docs">
			<classpath>
				<pathelement location="junit.jar"/>
			</classpath>
			<fileset dir="."/>
		</javadoc>
    </target>
</project>

